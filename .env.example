# Copy to .env at the repo root and set your own TIA Portal CustomControls
# directory. Shared by every control project's scripts/package-control.mjs as
# the destination for the packaged {GUID}.zip.
#
# Resolution order (last match wins):
#   1. this repo-root .env
#   2. <project>/.env        - optional, to override a single project
#   3. <project>/dist-controls  - fallback when no .env exists at all
TIA_PROJ = 'E:\tia v20\YourProject\UserFiles\CustomControls'
