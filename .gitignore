# Root ignore rules for this multi-project repo (NavigationBar, RecipePage, ...).
# Each control project is a Vite app that builds a single-file bundle into its
# own control/ folder, then zips it via scripts/package-control.mjs.

# Dependencies
node_modules/

# Build output
# vite.config.js sets build.outDir to '../control' with emptyOutDir, so every
# file Vite emits there is regenerated by `npm run build`.
# `control/*`, not `control/`: excluding the directory itself stops git
# descending into it, and a negation can never rescue a file inside an excluded
# directory. Matching the contents keeps the directory traversable so the icon
# below can be re-included.
control/*
!*/control/
# The single-file bundle Vite writes here on every build.
*/control/index.html
# ...except the control icon, which is a source asset referenced by
# manifest.json (control.identity.icon) and is NOT produced by the build.
!*/control/icons.png
dist/
dist-ssr/
# Default output of scripts/package-control.mjs when no .env is present.
dist-controls/
*.local

# Local environment
# The repo-root .env holds TIA_PROJ, the machine-specific TIA Portal target
# directory shared by every control project. See .env.example.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
